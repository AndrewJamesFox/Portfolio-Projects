    "evaluate_model(model)"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "743fd66d-98a7-4dc6-89fb-2dbc1876eabc",
   "metadata": {},
   "source": [
    "### Plot Results"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 165,
   "id": "e2b68545-67d2-45e4-bb4d-e854bf6531ea",
   "metadata": {},
   "outputs": [
    {
     "data": {
      "image/png": "",
      "text/plain": [
       "<Figure size 1000x600 with 1 Axes>"
      ]
     },
     "metadata": {},
     "output_type": "display_data"
    }
   ],
   "source": [
    "df = pd.DataFrame(results)\n",
    "\n",
    "# Melt df for easier plotting\n",
    "melted = df.melt(id_vars='model', var_name='metric', value_name='score')\n",
    "\n",
    "# Plot\n",
    "plt.figure(figsize=(10, 6))\n",
    "\n",
    "# Create grouped bar chart\n",
    "for i, metric in enumerate(['accuracy', 'precision', 'recall', 'f1_score']):\n",
    "    plt.bar(\n",
    "        x=[x + i*0.2 for x in range(len(df))],\n",
    "        height=melted[melted['metric'] == metric]['score'],\n",
    "        width=0.2,\n",
    "        label=metric\n",
    "    )\n",
    "\n",
    "# Custom x-ticks\n",
    "plt.xticks([x + 0.3 for x in range(len(df))], df['model'], rotation=0)\n",
    "\n",
    "plt.ylabel('Score (%)')\n",
    "plt.ylim(0, 100)\n",
    "plt.title('Model Performance Comparison')\n",
    "plt.legend()\n",
    "plt.tight_layout()\n",
    "plt.grid(axis='y', linestyle='--', alpha=0.5)\n",
    "\n",
    "# Show and/or save\n",
    "plt.savefig('/Users/andrewfox/Desktop/plot3.png')  # Update with your actual username/path\n",
    "plt.show()"
   ]
  },
