  {
   "cell_type": "code",
   "execution_count": 81,
   "id": "a3aecf63-d23f-47a0-8287-fa46bb7bceaf",
   "metadata": {},
   "outputs": [
    {
     "data": {
      "image/png": "",
      "text/plain": [
       "<Figure size 1400x600 with 1 Axes>"
      ]
     },
     "metadata": {},
     "output_type": "display_data"
    }
   ],
   "source": [
    "# PLOT 2\n",
    "results_df['label'] = results_df.apply(\n",
    "    lambda row: f\"{row['activation']}-L{row['layers']}-E{row['epochs']}\", axis=1\n",
    ")\n",
    "\n",
    "# Select metrics to plot\n",
    "metrics = ['accuracy', 'precision', 'recall', 'f1_score']\n",
    "labels = results_df['label']\n",
    "x = np.arange(len(labels))  # the label locations\n",
    "bar_width = 0.2\n",
    "\n",
    "# Set up the figure\n",
    "fig, ax = plt.subplots(figsize=(14, 6))\n",
    "\n",
    "# Plot each metric with an offset so bars don't overlap\n",
    "for i, metric in enumerate(metrics):\n",
    "    ax.bar(x + i * bar_width, results_df[metric], width=bar_width, label=metric)\n",
    "\n",
    "# X-axis setup\n",
    "ax.set_xticks(x + bar_width * (len(metrics) - 1) / 2)\n",
    "ax.set_xticklabels(labels, rotation=45, ha='right')\n",
    "\n",
    "# Labels, title, legend\n",
    "ax.set_ylabel('Score (%)')\n",
    "ax.set_title('Model Performance Across Hyperparameter Configurations')\n",
    "ax.set_ylim(0, 100)\n",
    "ax.legend()\n",
    "\n",
    "plt.tight_layout()\n",
    "plt.savefig('/Users/andrewfox/Desktop/plot2.png', dpi=300, bbox_inches='tight')\n",
    "plt.show()"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "ee4713eb-f408-4a99-b02c-1e505acfb402",
   "metadata": {},
   "source": [
    "The best performing model had parameters:\n",
    "\n",
    "{'activation': relu , 'layers': 16, 'epochs': 10}\n",
    "\n",
    "which achieved an accuracy of 78% and an f1-score of 0.81 for 0 and 0.73 for 1."
   ]
  },
  {
   "cell_type": "markdown",
   "id": "76de4bc4-5dda-4535-947e-a818d495e490",
   "metadata": {},
   "source": [
    "# Recurrent Neural Network (RNN) and Long Short-Term Memory (LSTM)\n",
    "I will now build a simple recurrent neural network followed by a LSTM implementation. For simplicity's sake, the best performing parameters from the simple dense model will be used, except each will have 64 hidden units as opposed to 16."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 147,
   "id": "44f5746b-30c8-4be5-bc17-ffcb0b69b4da",
   "metadata": {},
   "outputs": [],
   "source": [
    "results = []"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "952fc983-a960-441f-bbf9-f9d9746ca6b1",
   "metadata": {},
   "source": [
    "### Simple RNN"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 150,
   "id": "8e5576d8-357d-4f33-b901-9d61161dd5a1",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "\u001b[1m102/102\u001b[0m \u001b[32m‚îÅ‚îÅ‚îÅ‚îÅ‚îÅ‚îÅ‚îÅ‚îÅ‚îÅ‚îÅ‚îÅ‚îÅ‚îÅ‚îÅ‚îÅ‚îÅ‚îÅ‚îÅ‚îÅ‚îÅ\u001b[0m\u001b[37m\u001b[0m \u001b[1m1s\u001b[0m 4ms/step\n"
     ]
    }
   ],
   "source": [
    "def rnn_model(input_dim, output_dim, rnn_units=64, activation='relu', optimizer='adam'):\n",
    "    model = Sequential([\n",
    "        Embedding(input_dim=input_dim, output_dim=output_dim),\n",
    "        SimpleRNN(rnn_units, activation='relu'),\n",
    "        Dense(1, activation='sigmoid')\n",
    "    ])\n",
    "\n",
    "    model.compile(loss='binary_crossentropy', optimizer=optimizer, metrics=['accuracy'])\n",
    "    return model\n",
    "\n",
    "model = rnn_model(10000, 16, rnn_units=64)\n",
    "model.fit(X_train, y_train, validation_data=(X_test, y_test), epochs=10, batch_size=32, verbose=0)\n",
    "\n",
    "metrics = eval_model(model, X_test, y_test)\n",
    "metrics['model'] = 'Simple RNN'\n",
    "results.append(metrics)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 152,
   "id": "aa85c2d5-fc76-4160-86fb-a6532f05fa27",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "\u001b[1m102/102\u001b[0m \u001b[32m‚îÅ‚îÅ‚îÅ‚îÅ‚îÅ‚îÅ‚îÅ‚îÅ‚îÅ‚îÅ‚îÅ‚îÅ‚îÅ‚îÅ‚îÅ‚îÅ‚îÅ‚îÅ‚îÅ‚îÅ\u001b[0m\u001b[37m\u001b[0m \u001b[1m0s\u001b[0m 3ms/step - accuracy: 0.6801 - loss: 0.7981\n",
      "\u001b[1m102/102\u001b[0m \u001b[32m‚îÅ‚îÅ‚îÅ‚îÅ‚îÅ‚îÅ‚îÅ‚îÅ‚îÅ‚îÅ‚îÅ‚îÅ‚îÅ‚îÅ‚îÅ‚îÅ‚îÅ‚îÅ‚îÅ‚îÅ\u001b[0m\u001b[37m\u001b[0m \u001b[1m0s\u001b[0m 3ms/step\n",
      "              precision    recall  f1-score   support\n",
      "\n",
      "           0       0.69      0.77      0.73      1830\n",
      "           1       0.65      0.57      0.61      1428\n",
      "\n",
      "    accuracy                           0.68      3258\n",
      "   macro avg       0.67      0.67      0.67      3258\n",
      "weighted avg       0.68      0.68      0.68      3258\n",
      "\n"
     ]
    }
   ],
   "source": [
    "evaluate_model(model)"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "79cc955c-2db4-48f4-9393-fd2749e22be2",
   "metadata": {},
   "source": [
    "### LSTM"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 155,
   "id": "09385256-75de-4a64-a62b-4590de4e0b73",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "\u001b[1m102/102\u001b[0m \u001b[32m‚îÅ‚îÅ‚îÅ‚îÅ‚îÅ‚îÅ‚îÅ‚îÅ‚îÅ‚îÅ‚îÅ‚îÅ‚îÅ‚îÅ‚îÅ‚îÅ‚îÅ‚îÅ‚îÅ‚îÅ\u001b[0m\u001b[37m\u001b[0m \u001b[1m1s\u001b[0m 6ms/step\n"
     ]
    }
   ],
   "source": [
    "def lstm_model(input_dim, output_dim, lstm_units=64, optimizer='adam'):\n",
    "    model = Sequential([\n",
    "        Embedding(input_dim=input_dim, output_dim=output_dim),\n",
    "        LSTM(lstm_units),\n",
    "        Dense(1, activation='sigmoid')\n",
    "    ])\n",
    "\n",
    "    model.compile(loss='binary_crossentropy', optimizer=optimizer, metrics=['accuracy'])\n",
    "    return model\n",
    "\n",
    "model = lstm_model(10000, 16, lstm_units=64)\n",
    "model.fit(X_train, y_train, validation_data=(X_test, y_test), epochs=10, batch_size=32, verbose=0)\n",
    "\n",
    "metrics = eval_model(model, X_test, y_test)\n",
    "metrics['model'] = 'LSTM'\n",
    "results.append(metrics)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 157,
   "id": "5fe6b082-4180-4194-9424-ab9a53b3700c",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "\u001b[1m102/102\u001b[0m \u001b[32m‚îÅ‚îÅ‚îÅ‚îÅ‚îÅ‚îÅ‚îÅ‚îÅ‚îÅ‚îÅ‚îÅ‚îÅ‚îÅ‚îÅ‚îÅ‚îÅ‚îÅ‚îÅ‚îÅ‚îÅ\u001b[0m\u001b[37m\u001b[0m \u001b[1m1s\u001b[0m 6ms/step - accuracy: 0.7488 - loss: 1.1004\n",
      "\u001b[1m102/102\u001b[0m \u001b[32m‚îÅ‚îÅ‚îÅ‚îÅ‚îÅ‚îÅ‚îÅ‚îÅ‚îÅ‚îÅ‚îÅ‚îÅ‚îÅ‚îÅ‚îÅ‚îÅ‚îÅ‚îÅ‚îÅ‚îÅ\u001b[0m\u001b[37m\u001b[0m \u001b[1m1s\u001b[0m 5ms/step\n",
      "              precision    recall  f1-score   support\n",
      "\n",
      "           0       0.79      0.78      0.78      1830\n",
      "           1       0.72      0.73      0.72      1428\n",
      "\n",
      "    accuracy                           0.76      3258\n",
      "   macro avg       0.75      0.75      0.75      3258\n",
      "weighted avg       0.76      0.76      0.76      3258\n",
      "\n"
     ]
    }
   ],
   "source": [
    "evaluate_model(model)"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "00667d08-358e-4f7f-9964-fc83fdae79bc",
   "metadata": {},
   "source": [
    "### LSTM with dropout"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 160,
   "id": "1db2db49-3ca2-4a11-87d0-a013715b5bba",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "\u001b[1m102/102\u001b[0m \u001b[32m‚îÅ‚îÅ‚îÅ‚îÅ‚îÅ‚îÅ‚îÅ‚îÅ‚îÅ‚îÅ‚îÅ‚îÅ‚îÅ‚îÅ‚îÅ‚îÅ‚îÅ‚îÅ‚îÅ‚îÅ\u001b[0m\u001b[37m\u001b[0m \u001b[1m1s\u001b[0m 7ms/step\n"
     ]
    }
   ],
   "source": [
    "def lstm_model(input_dim, output_dim, lstm_units=64, optimizer='adam'):\n",
    "    model = Sequential([\n",
    "        Embedding(input_dim=input_dim, output_dim=output_dim),\n",
    "        LSTM(lstm_units, dropout=0.2, recurrent_dropout=0.2),\n",
    "        Dense(1, activation='sigmoid')\n",
    "    ])\n",
    "\n",
    "    model.compile(loss='binary_crossentropy', optimizer=optimizer, metrics=['accuracy'])\n",
    "    return model\n",
    "\n",
    "model = lstm_model(10000, 16, lstm_units=64)\n",
    "model.fit(X_train, y_train, validation_data=(X_test, y_test), epochs=10, batch_size=32, verbose=0)\n",
    "\n",
    "metrics = eval_model(model, X_test, y_test)\n",
    "metrics['model'] = 'LSTM with Dropout'\n",
    "results.append(metrics)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 162,
   "id": "beff8c6d-db40-4097-8671-903c62780e7b",
